# ── Mode ───────────────────────────────────────────────────────────────────
# true  = run fully offline against fixtures; no credentials needed.
# false = hit real Teams / Graph / Gemini. Requires everything below.
MOCK_MODE=true
NODE_ENV=development
PORT=3978
LOG_LEVEL=info

# ── Org settings ───────────────────────────────────────────────────────────
TENANT_DOMAIN=dramantram.com
MIN_MEETING_MINUTES=15
UNCERTAIN_TIMEOUT_HOURS=2
TRANSCRIPT_RETENTION_DAYS=30

# ── Azure AD app (TODO: register the app, then fill these) ─────────────────
# Portal > Azure AD > App registrations > New registration.
# Needs BOTH application and delegated Graph permissions, with admin consent:
#   Delegated:   OnlineMeetings.Read, OnlineMeetingTranscript.Read.All,
#                User.Read, Chat.ReadWrite
#   Application: OnlineMeetings.Read.All, OnlineMeetingTranscript.Read.All
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Bot Framework registration (usually the same app id/secret as above).
BOT_ID=
BOT_PASSWORD=

# Public HTTPS base URL of this server — Graph posts change notifications here.
# TODO: set once the Oracle VM + domain + Let's Encrypt cert exist.
PUBLIC_BASE_URL=
# Any random string; Graph echoes it back so we can reject forged webhooks.
WEBHOOK_CLIENT_STATE=

# ── Secrets at rest ────────────────────────────────────────────────────────
# Encrypts stored refresh tokens. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── LLMs (all free tiers; the chain falls through in this order) ───────────
# These work independently of MOCK_MODE: add a key here and extraction is real
# even while Graph and Teams stay stubbed. That is how you test with real
# transcripts before any Azure setup exists.
# Set FORCE_MOCK_LLM=true to keep using the offline extractor despite a key.
FORCE_MOCK_LLM=false
# Optional. Each model has its OWN free-tier daily quota (20 req/day/model),
# so the bot rotates through this list as each one is used up. Leave unset to
# use the built-in list. Set GEMINI_MODEL=<one-model> instead to pin a single one.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_API_KEY=

# ── Storage ────────────────────────────────────────────────────────────────
DB_PATH=data/cbd-bot.sqlite
OUTPUT_DIR=dist/output
