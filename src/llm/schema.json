{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Client Brief Document extraction",
  "description": "GENERATED by scripts/buildTemplateMap.js from the .docx template. Do not edit by hand.",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Client name plus the project or campaign name. e.g. \"Verdant Kitchens - Brand Identity & Website\"."
    },
    "launchDate": {
      "type": "string",
      "description": "Any deadline, launch or delivery date discussed. If none, use \"TBD, confirm with client\"."
    },
    "projectOwnerName": {
      "type": "string",
      "description": "The Dramantram person who owns this project. Taken from meeting metadata, not the transcript."
    },
    "projectOwnerEmail": {
      "type": "string",
      "description": "Email of the Dramantram project owner. From meeting metadata."
    },
    "projectOwnerPhone": {
      "type": "string",
      "description": "Phone of the Dramantram project owner. From meeting metadata. Empty if unknown."
    },
    "spoc": {
      "type": "string",
      "description": "Client-side day-to-day point of contact, with their role if stated. Empty string if never named."
    },
    "escalationPoint": {
      "type": "string",
      "description": "Senior client-side stakeholder to escalate to. Empty string if never named."
    },
    "businessObjective": {
      "type": "string",
      "description": "Why the client needs this and what they want to achieve. Two to four sentences. Use \\n between paragraphs."
    },
    "solutionScope": {
      "type": "string",
      "description": "The deliverables promised or discussed, one per line separated by \\n."
    },
    "keyMessage": {
      "type": "string",
      "description": "The core differentiator or tagline, ten words maximum."
    },
    "callToAction": {
      "type": "string",
      "description": "What the audience should do, ten words maximum."
    },
    "audienceProfile": {
      "type": "string",
      "description": "Demographics as discussed: geography, age, gender, income or occupation."
    },
    "otherMentions": {
      "type": "string",
      "description": "Anything important that does not fit another field: exclusions, constraints, caveats."
    },
    "releasePlatformOther": {
      "type": "string",
      "description": "Free text for any release platform not covered by the checkboxes. Empty string if none."
    },
    "languageMediumOther": {
      "type": "string",
      "description": "Free text for any language not covered by the checkboxes. Empty string if none."
    },
    "accentOther": {
      "type": "string",
      "description": "Free text for any accent not covered by the checkboxes. Empty string if none."
    },
    "availableResourcesOther": {
      "type": "string",
      "description": "Free text for any asset the client will provide that the checkboxes do not cover."
    },
    "clientOrgOverview": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Two entries: the client's website, then their social media channels. Empty strings if not discussed."
    },
    "checkboxes": {
      "type": "object",
      "description": "Which boxes to tick. Only use the exact strings listed; omit a group or use an empty array when the meeting gave no basis for ticking anything.",
      "properties": {
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "End Customer",
              "Executive & Management",
              "External Partners",
              "Internal team",
              "Webpage Visitors"
            ]
          }
        },
        "tone": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Casual",
              "Formal",
              "Fun/Witty",
              "Others",
              "Warm"
            ]
          }
        },
        "accent": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Indian",
              "Others",
              "UK",
              "USA"
            ]
          }
        },
        "video": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Adv. Film/ TVC",
              "Animated Explainers",
              "L&D/e-Learning Videos",
              "Live Action video",
              "Sales & Marketing video",
              "Stock based Videos"
            ]
          }
        },
        "availableResources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Brand Guideline",
              "Logo Open files",
              "Others",
              "Project Open Files"
            ]
          }
        },
        "design": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Brand Identity guidelines",
              "Magazine & Print designs",
              "Others",
              "Report/ PPT design",
              "Social Media Branding"
            ]
          }
        },
        "releasePlatform": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Others",
              "TV/ Broadcasting",
              "Website",
              "social media"
            ]
          }
        },
        "feeling": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Curious",
              "Informed",
              "Inspired",
              "Others",
              "Safe",
              "Scared"
            ]
          }
        },
        "contentConsulting": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Content Planning",
              "Creative Project executions"
            ]
          }
        },
        "emotions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Fear",
              "Happy",
              "Others",
              "Sad",
              "Surprised"
            ]
          }
        },
        "languageMedium": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "English",
              "Hindi",
              "Others"
            ]
          }
        },
        "smm": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Brand Presence/Awareness",
              "Grow your Audience/Market"
            ]
          }
        }
      },
      "required": []
    },
    "confidence": {
      "type": "object",
      "description": "How well the transcript supported each field: 5 explicitly stated, 4 strongly implied, 3 reasonable inference, 2 weak inference, 1 not discussed. Anything below 3 is flagged for human review in the document.",
      "properties": {
        "projectName": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "launchDate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "projectOwnerName": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "projectOwnerEmail": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "projectOwnerPhone": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "spoc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "escalationPoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "businessObjective": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "solutionScope": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "keyMessage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "callToAction": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "audienceProfile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "otherMentions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "releasePlatformOther": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "languageMediumOther": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "accentOther": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "availableResourcesOther": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": []
    }
  },
  "required": [
    "projectName",
    "businessObjective",
    "solutionScope",
    "checkboxes",
    "confidence"
  ]
}
