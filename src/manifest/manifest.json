{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "TODO_AZURE_AD_APP_ID",
  "packageName": "com.dramantram.cbdbot",
  "developer": {
    "name": "Dramantram Productions LLP",
    "websiteUrl": "https://www.dramantram.com",
    "privacyUrl": "https://www.dramantram.com/privacy",
    "termsOfUseUrl": "https://www.dramantram.com/terms"
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "name": {
    "short": "CBD Bot",
    "full": "Dramantram Client Brief Document Bot"
  },
  "description": {
    "short": "Drafts Client Brief Documents from your client meetings.",
    "full": "After a client meeting on Teams, CBD Bot reads the transcript, drafts the Dramantram Client Brief Document and sends it to you for review. Internal meetings are ignored. Fields the transcript did not clearly support are flagged for you to confirm."
  },
  "accentColor": "#2B2A6E",
  "bots": [
    {
      "botId": "TODO_AZURE_AD_APP_ID",
      "scopes": ["personal"],
      "isNotificationOnly": false,
      "supportsFiles": true,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "status", "description": "Show sign-in state and recent meetings" },
            { "title": "sign in", "description": "Authorise access to client-hosted transcripts" }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["TODO_your-public-domain.com"],
  "webApplicationInfo": {
    "id": "TODO_AZURE_AD_APP_ID",
    "resource": "api://TODO_your-public-domain.com/TODO_AZURE_AD_APP_ID"
  }
}
