{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    { "type": "TextBlock", "text": "Meeting detected", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "You just finished: ${title}", "wrap": true },
    {
      "type": "TextBlock",
      "text": "${durationMinutes} min · ${attendeeCount} attendees",
      "isSubtle": true,
      "spacing": "None"
    },
    { "type": "TextBlock", "text": "${question}", "wrap": true }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "${yesTitle}",
      "data": { "action": "confirmMeeting", "answer": "yes", "meetingId": "${meetingId}", "decisionId": "${decisionId}" }
    },
    {
      "type": "Action.Submit",
      "title": "No, skip",
      "data": { "action": "confirmMeeting", "answer": "no", "meetingId": "${meetingId}", "decisionId": "${decisionId}" }
    }
  ]
}
