{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    { "type": "TextBlock", "text": "Meeting detected", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "You just finished: ${title}", "wrap": true },
    {
      "type": "TextBlock",
      "text": "${durationMinutes} min · ${attendeeCount} attendees",
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "I could not tell whether this was a client meeting. What would you like?",
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Client brief",
      "data": { "action": "confirmMeeting", "answer": "client", "meetingId": "${meetingId}" }
    },
    {
      "type": "Action.Submit",
      "title": "Meeting brief",
      "data": { "action": "confirmMeeting", "answer": "meeting", "meetingId": "${meetingId}" }
    },
    {
      "type": "Action.Submit",
      "title": "Skip",
      "data": { "action": "confirmMeeting", "answer": "no", "meetingId": "${meetingId}" }
    }
  ]
}
