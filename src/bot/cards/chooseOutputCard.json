{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    { "type": "TextBlock", "text": "What should I make?", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "${detail}", "wrap": true }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Client brief",
      "data": { "action": "chooseOutput", "answer": "client", "token": "${token}" }
    },
    {
      "type": "Action.Submit",
      "title": "Meeting brief",
      "data": { "action": "chooseOutput", "answer": "meeting", "token": "${token}" }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": { "action": "chooseOutput", "answer": "cancel", "token": "${token}" }
    }
  ]
}
